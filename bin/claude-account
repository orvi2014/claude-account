#!/usr/bin/env bash
# claude-account was renamed to hatswap (https://github.com/orvi2014/hatswap).
# This stand-in keeps the old command and old `claude-account update` working:
# it runs hatswap from the same folder or your PATH, and fetches it once if it
# is missing.
set -euo pipefail
here="$(cd "$(dirname "$(python3 -c 'import os,sys;print(os.path.realpath(sys.argv[1]))' "$0")")" && pwd)"
if [[ -x "$here/hatswap" ]]; then exec "$here/hatswap" "$@"; fi
if command -v hatswap >/dev/null 2>&1; then exec hatswap "$@"; fi
echo "claude-account is now hatswap. Installing it next to this command..." >&2
tmp="$(mktemp)"
curl -fsSL "https://raw.githubusercontent.com/orvi2014/hatswap/main/bin/hatswap" -o "$tmp"
bash -n "$tmp"
chmod 755 "$tmp"
mv "$tmp" "$here/hatswap"
echo "Installed $("$here/hatswap" --version) to $here/hatswap; 'claude-account' keeps working." >&2
exec "$here/hatswap" "$@"
