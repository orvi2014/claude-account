# Re-record with:  bash demo/setup.sh && vhs demo/demo.tape
Output demo/demo.gif
Output demo/demo.mp4
Set Shell "bash"
Set FontSize 15
Set Width 1280
Set Height 720
Set Padding 24
Set Theme "Catppuccin Mocha"
Set TypingSpeed 35ms
Set CursorBlink false

Hide
Type "source /tmp/hatswap-demo/env.sh && clear" Enter
Sleep 500ms
Show

Type "hatswap" Sleep 400ms Enter
Sleep 2.5s
Down Sleep 700ms
Type "d" Sleep 1.8s
Down Sleep 700ms
Type "p" Sleep 1.8s
Type "q" Sleep 1s
Type "claude" Sleep 400ms Enter
Sleep 2.2s
Type "cd ~ && claude" Sleep 400ms Enter
Sleep 2s
Type "cd billing" Enter
Type "clear" Enter
Type "hatswap switch acme" Sleep 400ms Enter
Sleep 3s
Type "hatswap handoff codex" Sleep 400ms Enter
Sleep 5s
