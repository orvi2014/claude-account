# Re-record with:  bash demo/setup.sh && vhs demo/demo.tape
Output demo/demo.gif
Set Shell "bash"
Set FontSize 14
Set Width 1280
Set Height 720
Set Padding 24
Set Theme "Catppuccin Mocha"
Set TypingSpeed 35ms
Set CursorBlink false

Hide
Type "source /tmp/hatswap-demo/env.sh && clear" Enter
Sleep 500ms
Show

Type "hatswap list" Sleep 400ms Enter
Sleep 1.8s
Type "hatswap whoami" Sleep 400ms Enter
Sleep 2s
Type "hatswap switch work" Sleep 400ms Enter
Sleep 3s
Type "clear" Enter
Type "hatswap pin work" Sleep 400ms Enter
Sleep 2.5s
Type "claude" Sleep 400ms Enter
Sleep 2s
Type "cd ~ && claude" Sleep 400ms Enter
Sleep 2.5s
Type "cd billing" Enter
Type "clear" Enter
Type "hatswap handoff codex" Sleep 400ms Enter
Sleep 5s
